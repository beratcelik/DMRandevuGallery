<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>DMRandevu Galeri</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Saving a finished video is the whole point of the İndir and Reels buttons. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>İndirilen videolar telefonun galerisine kaydedilir.</string>
	<!-- Full access is asked for only so the videos can be filed in their own DMRandevu album;
	     add-only access still works, the videos just land in Son Öğeler instead. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Videolar DMRandevu albümüne kaydedilir.</string>

	<!-- Without these, canOpenURL always answers no and the Hikaye and Reels buttons would
	     report Instagram as missing even when it is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram</string>
		<string>instagram-stories</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- The feed is a full-screen portrait video reader; landscape would only letterbox it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
